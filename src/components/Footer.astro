---
import { withBase } from '../utils/paths';
---

<footer class="site-footer">
	<div class="footer-inner">
		<div>
			<a class="brand footer-brand" href={withBase()}>
				<span class="brand-mark" aria-hidden="true"><span></span></span>
				<span class="brand-name">Captured by Faith</span>
			</a>
			<p>Photography, faith, and the little things worth remembering.</p>
		</div>
		<div class="footer-links">
			<a href={withBase('/portfolio/')}>Portfolio</a>
			<a href={withBase('/about/')}>About</a>
			<a href={withBase('/contact/')}>Contact</a>
			<a href="https://www.instagram.com/captured.by.faith__/" rel="me noreferrer">Instagram</a>
		</div>
		<p class="footer-note">Made with care by Captured by Faith · © {new Date().getFullYear()}</p>
	</div>
</footer>
