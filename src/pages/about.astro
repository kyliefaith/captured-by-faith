---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
---

<BaseLayout
	title="About | Captured by Faith"
	description="Learn about the calm, attentive approach behind Captured by Faith photography."
>
	<section class="about-hero section-shell">
		<div>
			<p class="eyebrow">About</p>
			<h1>A gentle approach to honest photographs.</h1>
		</div>
		<img
			src={withBase('/images/about-study.svg')}
			alt="Abstract sample portrait in blue, ivory, and coral"
			width="1200"
			height="1400"
		/>
	</section>
	<section class="about-copy section-shell">
		<h2>There is no need to perform.</h2>
		<div>
			<p>
				Captured by Faith is built around attention, trust, and the belief that meaningful photographs
				do not need to feel forced.
			</p>
			<p>
				This starter copy intentionally avoids personal details. Replace it with your own story, values,
				and approach whenever you are ready.
			</p>
			<a class="text-link" href={withBase('/contact/')}>Get in touch</a>
		</div>
	</section>
</BaseLayout>
