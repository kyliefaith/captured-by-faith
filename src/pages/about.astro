---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
---

<BaseLayout
	title="About | Captured by Faith"
	description="Learn about the calm, attentive approach behind Captured by Faith photography."
>
	<section class="about-hero section-shell">
		<div>
			<p class="eyebrow">Hi, I am Kylie</p>
			<h1>Photos, faith, and finding joy in the everyday.</h1>
		</div>
		<img
			src={withBase('/images/about-study.svg')}
			alt="Abstract sample portrait in blue, ivory, and coral"
			width="1200"
			height="1400"
		/>
	</section>
	<section class="about-copy section-shell">
		<h2>A little about this space</h2>
		<div>
			<p>
				Captured by Faith is a home for photography, weekly reflections, personal goals, and the
				moments I want to remember.
			</p>
			<p>
				This starter copy is ready for Kylie to replace with her own story. No technical changes are
				needed: just edit this page when the words are ready.
			</p>
			<a class="text-link" href={withBase('/contact/')}>Get in touch</a>
		</div>
	</section>
</BaseLayout>
