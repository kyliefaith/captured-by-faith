---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Contact | Captured by Faith"
	description="Contact Captured by Faith on Instagram to begin planning a photography session."
>
	<section class="contact-page section-shell">
		<div>
			<p class="eyebrow">Contact</p>
			<h1>Tell me what you want to remember.</h1>
		</div>
		<div class="contact-panel">
			<p>
				For session questions and availability, send a message on Instagram. A direct email or inquiry
				form can be added here later.
			</p>
			<a
				class="button button-primary"
				href="https://www.instagram.com/captured.by.faith__/"
				rel="noreferrer"
			>
				Message on Instagram
			</a>
			<p class="handle">@captured.by.faith__</p>
		</div>
	</section>
</BaseLayout>
