---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import { withBase } from '../utils/paths';

const featured = (await getCollection('portfolio'))
	.filter((entry) => entry.data.featured)
	.sort((a, b) => a.data.order - b.data.order);
const latestJournal = (await getCollection('journal')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)[0];
---

<BaseLayout>
	<section class="hero section-shell">
		<div class="hero-copy">
			<p class="eyebrow">Portraits, families, celebrations</p>
			<h1>Hold onto how it felt.</h1>
			<p class="hero-intro">Honest, artful photography made with patience, warmth, and close attention.</p>
			<div class="button-row">
				<a class="button button-primary" href={withBase('/portfolio/')}>View portfolio</a>
				<a class="text-link" href={withBase('/contact/')}>Get in touch</a>
			</div>
		</div>
		<div class="hero-art" aria-hidden="true">
			<img src={withBase('/images/hero-study.svg')} alt="" width="1200" height="1500" fetchpriority="high" />
		</div>
	</section>

	<section class="intro-statement section-shell">
		<p>Photography for the in-between moments.</p>
		<h2>Images that feel like memory: gentle, vivid, and unmistakably yours.</h2>
	</section>

	<section class="featured-work section-shell">
		<div class="section-heading">
			<h2>Selected stories</h2>
			<p>Sample collections show the intended rhythm. Replace each image and Markdown file with your own work.</p>
		</div>
		<div class="portfolio-grid">
			{featured.map((entry, index) => <PortfolioCard entry={entry} priority={index === 0} />)}
		</div>
	</section>

	<section class="process-band">
		<div class="section-shell process-inner">
			<div>
				<h2>Present over perfect.</h2>
				<p>The best photographs happen when there is room to settle in, move naturally, and trust the process.</p>
			</div>
			<a class="button button-light" href={withBase('/about/')}>About the approach</a>
		</div>
	</section>

	{
		latestJournal && (
			<section class="journal-feature section-shell">
				<img
					src={withBase(latestJournal.data.cover)}
					alt={latestJournal.data.coverAlt}
					width="1200"
					height="800"
					loading="lazy"
				/>
				<div>
					<p class="eyebrow">Latest journal</p>
					<h2>{latestJournal.data.title}</h2>
					<p>{latestJournal.data.description}</p>
					<a class="text-link" href={withBase(`/journal/${latestJournal.id}/`)}>
						Read the note
					</a>
				</div>
			</section>
		)
	}

	<section class="contact-callout section-shell">
		<p>Have a story you want to remember?</p>
		<h2>Let’s make something honest together.</h2>
		<a class="button button-primary" href={withBase('/contact/')}>Get in touch</a>
	</section>
</BaseLayout>
