---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import { withBase } from '../utils/paths';

const featured = (await getCollection('portfolio'))
	.filter((entry) => entry.data.featured)
	.sort((a, b) => a.data.order - b.data.order);
const journalEntries = (await getCollection('journal')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout>
	<section class="hero section-shell" aria-labelledby="hero-title">
		<div class="hero-copy">
			<p class="eyebrow">Welcome, I am so glad you are here</p>
			<h1 id="hero-title">Hold onto joy.</h1>
			<p class="hero-intro">Photography, faith, and happy little updates from along the way.</p>
			<div class="button-row">
				<a class="button button-primary" href={withBase('/portfolio/')}>See my photos</a>
				<a class="text-link" href={withBase('/journal/')}>Read the journal</a>
			</div>
		</div>
		<div class="hero-collage" aria-label="Sample photography collage">
			<figure class="photo-print photo-print-main">
				<img
					src={withBase('/images/quiet-mornings.svg')}
					alt="Sample placeholder for a featured portrait"
					width="1200"
					height="1500"
					fetchpriority="high"
				/>
				<figcaption>the sweet, everyday moments</figcaption>
			</figure>
			<figure class="photo-print photo-print-small">
				<img
					src={withBase('/images/gathered-light.svg')}
					alt="Sample placeholder for a celebration photograph"
					width="1200"
					height="1500"
				/>
			</figure>
			<div class="doodle-heart" aria-hidden="true">♡</div>
		</div>
	</section>

	<section class="welcome-note section-shell">
		<div class="tape" aria-hidden="true"></div>
		<p class="handwritten">Hi, friend!</p>
		<h2>This is my little corner for photos, faith, goals, and everything in between.</h2>
		<p>
			Captured by Faith is where I share the people and moments I photograph, what I am learning,
			and the good things happening lately.
		</p>
	</section>

	<section class="featured-work section-shell">
		<div class="section-heading">
			<p class="handwritten">Behind the camera</p>
			<h2>Recent photo stories</h2>
			<p>A few favorite sessions, celebrations, and everyday memories.</p>
		</div>
		<div class="portfolio-grid">
			{featured.map((entry, index) => <PortfolioCard entry={entry} priority={index === 0} />)}
		</div>
		<a class="button button-secondary section-button" href={withBase('/portfolio/')}>Browse all photos</a>
	</section>

	<section class="journal-home">
		<div class="section-shell">
			<div class="section-heading journal-heading">
				<p class="handwritten">From the journal</p>
				<h2>What I am sharing lately</h2>
				<p>Weekly notes about faith, life, and the small wins along the way.</p>
			</div>
			<div class="journal-home-grid">
				{
					journalEntries.slice(0, 3).map((entry) => (
						<article class="journal-note">
							<a href={withBase(`/journal/${entry.id}/`)}>
								<img
									src={withBase(entry.data.cover)}
									alt={entry.data.coverAlt}
									width="1200"
									height="800"
									loading="lazy"
								/>
								<div>
									<p class="journal-category">{entry.data.category}</p>
									<h3>{entry.data.title}</h3>
									<p>{entry.data.description}</p>
									<span>Read more</span>
								</div>
							</a>
						</article>
					))
				}
			</div>
			<a class="button button-secondary section-button" href={withBase('/journal/')}>Visit the journal</a>
		</div>
	</section>

	<section class="contact-callout section-shell">
		<div class="contact-sticker" aria-hidden="true">say cheese!</div>
		<p class="handwritten">Let's make memories</p>
		<h2>Want photos that feel like you?</h2>
		<p>Send me a message on Instagram and tell me what you have in mind.</p>
		<a class="button button-primary" href={withBase('/contact/')}>Say hello</a>
	</section>
</BaseLayout>
